const APPLICATION_SHEET_ID = '10-BJcEl9KbrYimFk5QgbTmUsWN2n4i6aOiA8KmJbVXU';
const APPLICATION_TAB = 'Applications';
const APPLICATION_HEADERS = ['Application ID','Submitted At','Student Name','Student Email','Parent Name','Parent Email','Instrument','Performance Clip','Status'];
function setupJoinApplications(){const spreadsheet=SpreadsheetApp.openById(APPLICATION_SHEET_ID);let sheet=spreadsheet.getSheetByName(APPLICATION_TAB);if(!sheet)sheet=spreadsheet.insertSheet(APPLICATION_TAB);if(sheet.getLastRow()===0)sheet.appendRow(APPLICATION_HEADERS);sheet.setFrozenRows(1);sheet.getRange(1,1,1,APPLICATION_HEADERS.length).setFontWeight('bold');const folder=DriveApp.createFolder('AmeriCal Orchestra Applications');PropertiesService.getScriptProperties().setProperty('APPLICATION_FOLDER_ID',folder.getId());return folder.getUrl();}
function doPost(event){try{const data=JSON.parse(event.postData.contents||'{}');if(data.action!=='submitApplication')throw new Error('Unknown action.');['studentName','studentEmail','parentName','parentEmail','instrument','clipName','clipData'].forEach(function(field){if(!data[field])throw new Error('Missing '+field);});const folderId=PropertiesService.getScriptProperties().getProperty('APPLICATION_FOLDER_ID');if(!folderId)throw new Error('Run setupJoinApplications first.');const applicationId=Utilities.getUuid();const safeName=String(data.clipName).replace(/[^a-zA-Z0-9._-]/g,'_');const blob=Utilities.newBlob(Utilities.base64Decode(data.clipData),data.clipType||'application/octet-stream',applicationId+'-'+safeName);const file=DriveApp.getFolderById(folderId).createFile(blob);file.setDescription('AmeriCal application clip for '+data.studentName);const sheet=SpreadsheetApp.openById(APPLICATION_SHEET_ID).getSheetByName(APPLICATION_TAB);sheet.appendRow([applicationId,new Date(),data.studentName,data.studentEmail,data.parentName,data.parentEmail,data.instrument,file.getUrl(),'New']);return jsonOutput_({ok:true,applicationId:applicationId});}catch(error){return jsonOutput_({ok:false,error:error.message});}}
function jsonOutput_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
